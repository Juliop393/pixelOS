# ── Públicas (NEXT_PUBLIC_* — visibles en el navegador) ──

# Supabase — proyecto y clave pública
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# URL pública canónica del sitio (usada para redirects OAuth detrás de proxies)
NEXT_PUBLIC_SITE_URL=https://pixelfm.com

# Paddle — Price IDs para checkout
NEXT_PUBLIC_PADDLE_PRICE_STARTER=your_starter_price_id
NEXT_PUBLIC_PADDLE_PRICE_PRO=your_pro_price_id
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=your_business_price_id

# Paddle — client token para inicializar Paddle.js en frontend
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_paddle_client_token

# ── Privadas (solo servidor — nunca usar NEXT_PUBLIC_) ──

# Supabase — service role key (admin, salta RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Paddle — API key para llamadas server-side (portal sessions, etc.)
PADDLE_API_KEY=your_paddle_api_secret

# Paddle — webhook secret para verificar firmas
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret

# Kimi (Moonshot AI) — API key para Pixel IA
KIMI_API_KEY=your_kimi_api_key

# n8n — webhook de generación de creativos
N8N_WEBHOOK_URL=your_n8n_webhook_url
N8N_INTERNAL_SECRET=your_n8n_internal_secret

# Admin — emails permitidos (separados por coma)
PIXELFM_ADMIN_EMAILS=admin@example.com
