# ── Públicas (NEXT_PUBLIC_* — visibles en el navegador) ──

# Supabase — proyecto y clave pública
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# URL pública canónica del sitio (usada para redirects OAuth detrás de proxies)
NEXT_PUBLIC_SITE_URL=https://pixelfm.com

# ── Privadas (solo servidor — nunca usar NEXT_PUBLIC_) ──

# Supabase — service role key (admin, salta RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Stripe — clave secreta y secreto del webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe — Price IDs de los planes (solo servidor)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Stripe — TEMPORAL: único usuario que puede abrir Checkout de prueba (solo con sk_test_)
STRIPE_TEST_ALLOWED_USER_ID=

# Kimi (Moonshot AI) — API key para Pixel IA
KIMI_API_KEY=your_kimi_api_key

# n8n — webhook de generación de creativos (imágenes)
N8N_WEBHOOK_URL=your_n8n_webhook_url
N8N_INTERNAL_SECRET=your_n8n_internal_secret

# n8n — webhook de generación de video (Hailuo)
N8N_VIDEO_WEBHOOK_URL=your_n8n_video_webhook_url
N8N_VIDEO_STATUS_WEBHOOK_URL=your_n8n_video_status_webhook_url

# Admin — emails permitidos (separados por coma)
PIXELFM_ADMIN_EMAILS=admin@example.com
